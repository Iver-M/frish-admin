rules_version = '2';

// GENERATED by npm run firebase:rules:build. Edit rules/ sources; do not edit this file.
// Controlled cloud test only. Production remains disabled; existing approval gates apply.
// Environment: cloud. See docs/rag/15-firebase-environments.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Shared account helpers
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function supportedAdminSession() {
      return signedIn() && (
        request.auth.token.firebase.sign_in_provider == 'password'
        || (request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true)
      );
    }

    function activeProfile() {
      return profile().get(
        'accountStatus',
        profile().get('status', 'active')
      ) == 'active';
    }

    function isBfar() {
      return supportedAdminSession()
        && profile().role == 'bfar_admin'
        && activeProfile();
    }

    function isInspector() {
      return signedIn()
        && profile().role == 'inspector'
        && profile().accountStatus == 'active';
    }

    function isPasigMarketAdmin() {
      return supportedAdminSession()
        && profile().role == 'market_admin'
        && profile().marketId == 'pasig'
        && activeProfile();
    }

    function isAdmin() {
      return isBfar() || isPasigMarketAdmin();
    }

    function ownsInspectorRecord(data) {
      return signedIn()
        && data.createdBy.uid == request.auth.uid
        && data.createdBy.role == 'inspector';
    }

    function isPasigReportUpdate() {
      // Old mobile reports may receive marketId only when BFAR forwards them.
      return isPasigMarketAdmin()
        && resource.data.get('marketId', '') in ['', 'pasig']
        && request.resource.data.get('marketId', '') == 'pasig';
    }

    // Mobile users may create only their own active Inspector profile.
    function isInspectorSelfProfileCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'inspector'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'name', 'phone', 'role',
          'accountStatus', 'createdAt', 'updatedAt'
        ]);
    }

    // Inspectors may repair missing role/status fields and edit profile details.
    function isInspectorSelfProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'name', 'phone', 'role', 'accountStatus', 'updatedAt'
        ])
        && resource.data.get('role', '') in ['', 'inspector']
        && request.resource.data.get('role', '') == 'inspector'
        && resource.data.get('accountStatus', '') in ['', 'active']
        && request.resource.data.get('accountStatus', '') == 'active';
    }

    // Active admins may edit only their own non-security profile fields.
    function isAdminSelfProfileUpdate(userId) {
      return isAdmin()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'phone', 'department', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('accountStatus', 'active')
          == resource.data.get('accountStatus', 'active')
        && request.resource.data.get('marketId', '')
          == resource.data.get('marketId', '');
    }

    // User profiles and role management
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isBfar() || isInspectorSelfProfileCreate(userId);
      allow update: if isBfar()
        || isInspectorSelfProfileUpdate(userId)
        || isAdminSelfProfileUpdate(userId);
      allow delete: if isBfar();
    }

    // Legacy assessment records remain admin-readable.
    match /assessments/{assessmentId} {
      allow read: if isAdmin();
    }

    // Inspector scan ownership; signed-in clients retain read compatibility.
    match /scans/{scanId} {
      allow create: if ownsInspectorRecord(request.resource.data);
      allow read: if signedIn();
      allow update: if ownsInspectorRecord(resource.data)
        && ownsInspectorRecord(request.resource.data);
      allow delete: if ownsInspectorRecord(resource.data);
    }

    // Inspector freshness predictions
    match /predictions/{predictionId} {
      allow create: if isInspector()
        && request.resource.data.inspectorUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.inspectorUid == request.auth.uid || isBfar());
      allow update, delete: if isInspector()
        && resource.data.inspectorUid == request.auth.uid;
    }

    // Pasig LGU vendor records
    match /vendors/{vendorId} {
      allow read: if isAdmin();
      allow create: if isPasigMarketAdmin()
        && request.resource.data.marketId == 'pasig';
      allow update: if isPasigMarketAdmin()
        && resource.data.marketId == 'pasig'
        && request.resource.data.marketId == 'pasig';
      allow delete: if false;
    }

    // Inspector feedback and BFAR response lifecycle
    match /feedback/{feedbackId} {
      allow create: if isInspector()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'inspector'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;

      allow read: if isBfar()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if isBfar()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'adminReply', 'resolvedBy', 'resolvedAt'
        ])
        && request.resource.data.status in [
          'pending', 'in-progress', 'reviewed', 'resolved', 'dismissed'
        ]
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isBfar();
    }

    // Inspector reports and BFAR-to-LGU workflow
    match /reports/{reportId} {
      allow read: if isAdmin()
        || (isInspector()
          && resource.data.keys().hasAny(['assignedInspectorId'])
          && resource.data.assignedInspectorId == request.auth.uid)
        || (isInspector()
          && resource.data.createdBy.uid == request.auth.uid);

      allow create: if ownsInspectorRecord(request.resource.data)
        && request.resource.data.status == 'submitted'
        && request.resource.data.sourceType == 'inspector';

      allow update: if isBfar() || isPasigReportUpdate();
    }

    // Private BFAR conclusions for original reporters
    match /reporterNotifications/{notificationId} {
      allow read: if isBfar()
        || (signedIn() && resource.data.recipientUid == request.auth.uid);

      allow create: if isBfar()
        && request.resource.data.recipientUid is string
        && request.resource.data.reportId is string;

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.reportId == resource.data.reportId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readAt'
        ])
        && request.resource.data.readAt is timestamp;

      allow delete: if false;
    }

    // Append-only BFAR and LGU audit activity
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Cloud-only IoT contract; keep the existing dedicated device identity.
    match /sensorReadings/{deviceId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == "sqwimdEeObQfDraEZhz0zAzNKc42"
        && request.resource.data.keys().hasOnly([
          'deviceId', 'temperature', 'humidity', 'gasResistance', 'status', 'updatedAt'
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.temperature is number
        && request.resource.data.humidity is number
        && request.resource.data.gasResistance is number
        && request.resource.data.status == 'online'
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymousOwner(ownerId) {
      return isSignedIn()
        && request.auth.uid == ownerId
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsConcernReportId(reportId) {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && reportId.matches(
          '^report_' + request.auth.uid + '_[A-Za-z0-9_-]+$'
        );
    }

    // Remote accuracy is bounded to 100 km; Functions validate calendar semantics.
    // Rules accept the canonical UTC millisecond representation only.
    function validScanLocation(location) {
      return location is map
        && location.keys().hasAll([
          'status',
          'latitude',
          'longitude',
          'accuracyMeters',
          'capturedAt',
          'source',
          'precision'
        ])
        && location.keys().hasOnly([
          'status',
          'latitude',
          'longitude',
          'accuracyMeters',
          'capturedAt',
          'source',
          'precision'
        ])
        && location.source == 'device_foreground'
        && (
          (location.status == 'recorded'
            && location.latitude is number
            && location.latitude >= -90
            && location.latitude <= 90
            && location.longitude is number
            && location.longitude >= -180
            && location.longitude <= 180
            && location.accuracyMeters is number
            && location.accuracyMeters >= 0
            && location.accuracyMeters <= 100000
            && location.capturedAt is string
            && location.capturedAt.size() == 24
            && location.capturedAt.matches(
              '^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$'
            )
            && location.precision in ['precise', 'approximate'])
          || (location.status in [
              'permission_denied',
              'permission_blocked',
              'provider_disabled',
              'timeout',
              'unavailable'
            ]
            && location.latitude == null
            && location.longitude == null
            && location.accuracyMeters == null
            && location.capturedAt == null
            && location.precision == null)
        );
    }

    function locationIso(value) {
      return value is string && value.size() == 24 && value.matches(
        '^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$');
    }

    function validSelectedPlace(place) {
      return place == null || (place is map && place.keys().size() == 5
        && place.keys().hasOnly(['provider', 'api', 'placeId', 'retrievedAt', 'refreshAfter'])
        && place.provider == 'google_maps' && place.api == 'places_new'
        && place.placeId is string && place.placeId.matches('^[A-Za-z0-9_-]{1,200}$')
        && locationIso(place.retrievedAt) && locationIso(place.refreshAfter)
        && place.refreshAfter > place.retrievedAt);
    }

    function validSelectedLocation(selected, captured, source) {
      return selected is map && selected.keys().size() == 4
        && selected.keys().hasOnly(['coordinateOrigin', 'point', 'pointRetention', 'place'])
        && validSelectedPlace(selected.place)
        && ((selected.coordinateOrigin == 'device_foreground'
            && source == 'device_detected' && captured.status == 'recorded'
            && selected.pointRetention == 'durable_device' && selected.place == null
            && selected.point is map && selected.point.keys().size() == 2
            && selected.point.keys().hasOnly(['latitude', 'longitude'])
            && selected.point.latitude == captured.latitude && selected.point.longitude == captured.longitude)
          || (selected.coordinateOrigin in ['google_places', 'google_map_interaction', 'unknown']
            && selected.point == null
            && ((selected.coordinateOrigin == 'unknown' && selected.pointRetention == 'unknown_omitted')
              || (selected.coordinateOrigin != 'unknown' && selected.pointRetention == 'session_only'))
            && (selected.coordinateOrigin == 'google_places'
              ? source in ['address_search', 'pin_adjusted']
              : selected.place == null)
            && (selected.coordinateOrigin != 'google_map_interaction' || source == 'pin_adjusted')));
    }

    function validDurableLocation(location, scanId) {
      return location is map && location.keys().size() == 8
        && location.keys().hasOnly(['schemaVersion', 'policyVersion', 'scanId', 'captured',
          'confirmationStatus', 'confirmationSource', 'confirmedAt', 'selected'])
        && location.schemaVersion == '2.0' && location.policyVersion == 'frish-location-2026-09-19'
        && location.scanId == scanId && validScanLocation(location.captured)
        && (location.confirmationSource != 'device_detected' || location.captured.status == 'recorded')
        && ((location.confirmationStatus == 'confirmed'
            && location.confirmationSource in ['device_detected', 'pin_adjusted', 'address_search']
            && locationIso(location.confirmedAt)
            && validSelectedLocation(location.selected, location.captured, location.confirmationSource))
          || (location.confirmationStatus in ['unconfirmed', 'skipped', 'unavailable']
            && location.confirmedAt == null && location.selected == null
            && (location.confirmationStatus == 'unconfirmed'
              ? location.confirmationSource in ['device_detected', 'pin_adjusted', 'address_search']
              : location.confirmationSource == location.confirmationStatus)
            && (location.confirmationStatus != 'unavailable' || location.captured.status != 'recorded')));
    }

    function validNewScan(scanId) {
      let data = request.resource.data;
      return isSignedIn()
        && data.keys().hasAll([
          'schemaVersion',
          'scanId',
          'ownerId',
          'species',
          'includeGills',
          'status',
          'evidence',
          'location',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'scanId',
          'ownerId',
          'species',
          'includeGills',
          'status',
          'evidence',
          'location',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion in ['1.2', '1.3']
        && data.scanId is string
        && data.scanId == scanId
        && data.scanId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.species in ['galunggong', 'dalagang_bukid']
        && data.includeGills is bool
        && data.status == 'pending_analysis'
        && data.evidence is map
        && data.evidence.keys().hasOnly(['eyesAndSkin', 'gills'])
        && data.evidence.eyesAndSkin is map
        && data.evidence.eyesAndSkin.keys().hasOnly(['storagePath'])
        && data.evidence.eyesAndSkin.storagePath
          == 'consumerScans/' + request.auth.uid + '/' + scanId + '/eyesAndSkin'
        && (
          (data.includeGills == true
            && data.evidence.gills is map
            && data.evidence.gills.keys().hasOnly(['storagePath'])
            && data.evidence.gills.storagePath
              == 'consumerScans/' + request.auth.uid + '/' + scanId + '/gills')
          || (data.includeGills == false && data.evidence.gills == null)
        )
        && (data.schemaVersion == '1.3' ? validDurableLocation(data.location, scanId) : validScanLocation(data.location))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /consumerScans/{scanId} {
      allow create: if validNewScan(scanId);
      allow get, list: if ownsExistingDocument();
      allow update, delete: if false;
    }

    function feedbackUuid(value) {
      return value is string && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function feedbackText(value, limit) {
      // Same whitespace set as ECMAScript trim, including Unicode separators.
      return value is string && value.size() > 0 && value.size() <= limit
        && value.matches('^[^\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]([\\s\\S]*[^\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff])?$');
    }

    // One predicate for the environment tags on both create and existing reads.
    function feedbackEnvironmentMatches(data) {
      return data.environment == 'online_test'
        && data.dataVersion == 'consumer-feedback-test-v1'
        && data.testRunId == 'feedback-team-v1';
    }

    match /consumerFeedback/{feedbackId} {
      // Missing-document get is needed by create-if-absent transactions.
      allow get: if isAnonymousOwner(request.auth.uid)
        && request.auth.uid.matches('^[A-Za-z0-9_-]+$')
        && feedbackId.matches('^feedback_' + request.auth.uid + '_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && (!exists(/databases/$(database)/documents/consumerFeedback/$(feedbackId))
          || (resource.data.ownerId == request.auth.uid
            && feedbackEnvironmentMatches(resource.data)));
      // Every allowed field is required by the predicates below.
      allow create: if request.resource.data.keys().hasOnly([
          'schemaVersion', 'feedbackId', 'ownerId', 'submissionId', 'rating',
          'feedbackText', 'appVersion', 'platform', 'platformVersion', 'status',
          'deliveryMode', 'createdAt', 'submittedAt', 'environment', 'dataVersion', 'testRunId'])
        && isAnonymousOwner(request.resource.data.ownerId)
        && feedbackUuid(request.resource.data.submissionId)
        && feedbackId == 'feedback_' + request.auth.uid + '_' + request.resource.data.submissionId
        && request.resource.data.feedbackId == feedbackId
        && request.resource.data.schemaVersion == '1.1'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && feedbackText(request.resource.data.feedbackText, 2000)
        && feedbackText(request.resource.data.appVersion, 40)
        && feedbackText(request.resource.data.platformVersion, 40)
        && request.resource.data.platform == 'android'
        && request.resource.data.status == 'prototype_saved'
        && request.resource.data.deliveryMode == 'firebase_online_test'
        && feedbackEnvironmentMatches(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time;
      allow list, update, delete: if false;
    }

    function validNewConcernReport(reportId) {
      let data = request.resource.data;
      let scanPath = /databases/$(database)/documents/consumerScans/$(data.scanId);
      return isAnonymousOwner(data.ownerId)
        && data.keys().hasAll([
          'schemaVersion',
          'reportId',
          'scanId',
          'ownerId',
          'marketName',
          'reporterName',
          'reporterEmail',
          'vendorOrStall',
          'reason',
          'description',
          'resultSummary',
          'status',
          'deliveryMode',
          'createdAt',
          'submittedAt', 'environment', 'testRunId', 'dataVersion'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'reportId',
          'scanId',
          'ownerId',
          'marketName',
          'reporterName',
          'reporterEmail',
          'vendorOrStall',
          'reason',
          'description',
          'resultSummary',
          'status',
          'deliveryMode',
          'createdAt',
          'submittedAt', 'environment', 'testRunId', 'dataVersion'
        ])
        && data.schemaVersion == '1.1'
        && data.reportId is string
        && data.reportId == reportId
        && data.scanId is string
        && data.scanId.size() > 0
        && data.scanId.size() <= 128
        && data.scanId.matches('^[A-Za-z0-9_-]+$')
        && reportId == 'report_' + request.auth.uid + '_' + data.scanId
        && exists(scanPath)
        && get(scanPath).data.ownerId == request.auth.uid
        && data.marketName is string
        && data.marketName.size() > 0
        && data.marketName.size() <= 120
        && data.reporterName is string
        && data.reporterName.size() > 0
        && data.reporterName.size() <= 120
        && data.reporterEmail is string
        && data.reporterEmail.size() > 0
        && data.reporterEmail.size() <= 254
        && data.vendorOrStall is string
        && data.vendorOrStall.size() > 0
        && data.vendorOrStall.size() <= 160
        && data.reason in [
          'spoiled_at_scan',
          'spoiled_after_purchase',
          'suspected_treatment',
          'other'
        ]
        && data.description is string
        && data.description.size() <= 2000
        && data.resultSummary == null
        && data.status == 'prototype_saved'
        && data.deliveryMode == 'firebase_cloud_test'
        && data.environment == 'cloud_test'
        && data.testRunId == 'cloud-report-team-v1'
        && data.dataVersion == 'consumer-report-cloud-test-v1'
        && data.createdAt == request.time
        && data.submittedAt == request.time;
    }

    match /concernReports/{reportId} {
      allow create: if validNewConcernReport(reportId);
      // A transaction must be able to read its deterministic document before
      // the first create. The UID-prefixed ID still prevents cross-owner gets.
      allow get: if ownsConcernReportId(reportId);
      // Firestore proves this predicate for every possible query result, so an
      // ownerId equality constraint is required for collection reads.
      allow list: if ownsExistingDocument();
      allow update, delete: if false;
    }

    function hasActiveClaim(role) {
      return isSignedIn()
        && request.auth.token.role == role
        && request.auth.token.environment == 'staging'
        && request.auth.token.cloudTestApproved == true
        && request.auth.token.claimVersion == 'frish-cloud-test-v1'
        && request.auth.token.policyVersion == 'frish-cloud-test-v1'
        && request.auth.token.marketIds.hasAny(['pasig'])
        && request.auth.token.accountStatus == 'active';
    }

    function isBfarAuthority() {
      return hasActiveClaim('bfar_admin');
    }

    function isLguAuthority() {
      return (hasActiveClaim('lgu') || hasActiveClaim('lgu_admin') || hasActiveClaim('market_admin'))
        && request.auth.token.marketIds.hasAny(['pasig']);
    }

    function isInspectorAuthority() {
      return hasActiveClaim('inspector');
    }

    match /authorityCases/{caseId} {
      allow get, list: if isBfarAuthority()
        || (isLguAuthority()
          && resource.data.marketId == 'pasig'
          && resource.data.status in ['forwarded_lgu', 'resolved'])
        || (isInspectorAuthority()
          && resource.data.assignedInspectorId == request.auth.uid);
      // Authority-case lifecycle writes are trusted-backend transactions only.
      // Client SDK calls are denied even when their transition shape is valid.
      allow create, update, delete: if false;
    }

    match /authorityCaseReporterContacts/{reporterRef} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /authorityCaseSources/{caseId} {
      allow read, write: if false;
    }

    match /authorityIntakeDecisions/{reportId} {
      allow read, write: if false;
    }

    match /authorityCaseTransitionRequests/{requestId} {
      // Idempotency receipts contain transition results and actor bindings.
      // They are neither a client-readable status surface nor client-writable.
      allow read, write: if false;
    }

    match /authorityCaseAudit/{eventId} {
      allow read: if isBfarAuthority()
        || (isLguAuthority()
          && resource.data.marketId == 'pasig'
          && resource.data.nextStatus in ['forwarded_lgu', 'resolved']);
      allow create, update, delete: if false;
    }

    match /authorityEvidenceAccessAudit/{eventId} {
      allow read, write: if false;
    }
  }
}
