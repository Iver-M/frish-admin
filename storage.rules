rules_version = '2';

// GENERATED by npm run firebase:rules:build. Edit rules/ sources; do not edit this file.
// Controlled cloud test only. Production remains disabled; existing approval gates apply.
// Environment: cloud. See docs/rag/15-firebase-environments.md.
service firebase.storage {
  match /b/{bucket}/o {
    // Existing Inspector/Admin evidence paths.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isBfar() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'bfar_admin';
    }

    function isAnonymousOwner(ownerId) {
      return request.auth != null
        && request.auth.uid == ownerId
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isApprovedImage() {
      return request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    function hasApprovedMetadata(ownerId, scanId, assetRole) {
      return request.resource.metadata.keys().hasAll([
          'ownerId',
          'scanId',
          'assetRole', 'environment', 'testRunId'
        ])
        && request.resource.metadata.keys().hasOnly([
          'ownerId',
          'scanId',
          'assetRole', 'environment', 'testRunId'
        ])
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.scanId == scanId
        && request.resource.metadata.assetRole == assetRole
        && request.resource.metadata.environment == 'cloud_test'
        && request.resource.metadata.testRunId == 'cloud-report-team-v1';
    }

    match /consumerScans/{ownerId}/{scanId}/{assetRole} {
      allow read: if isAnonymousOwner(ownerId);
      allow delete: if isAnonymousOwner(ownerId)
        && !firestore.exists(/databases/(default)/documents/concernReports/$('report_' + ownerId + '_' + scanId));
      allow create, update: if resource == null
        && isAnonymousOwner(ownerId)
        && scanId.matches('^[A-Za-z0-9_-]+$')
        && scanId.size() > 0
        && scanId.size() <= 128
        && assetRole in ['eyesAndSkin', 'gills']
        && isApprovedImage()
        && hasApprovedMetadata(ownerId, scanId, assetRole);
    }

    match /assessments/{assessmentId}/{fileName} {
      allow read: if signedIn();
      allow write: if isBfar();
    }

    match /reports/{reportId}/{fileName} {
      allow read: if signedIn();
      allow write: if isBfar();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
